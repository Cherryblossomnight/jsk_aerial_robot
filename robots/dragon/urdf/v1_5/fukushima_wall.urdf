<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="opening2" >

  <xacro:arg name="opening_height" default="2.0" /> <!-- m -->
  <xacro:arg name="opening_width" default="0.0" /> <!-- m -->
  <xacro:arg name="env_width" default="4.0" /> <!-- m -->
  <xacro:arg name="env_length" default="6.0" /> <!-- m -->
  <xacro:property name="frame_mass" value="10" />

  <material name="red">
    <color rgba="1 0 0 0"/>
  </material>


  <xacro:macro name="frame_model" params="name mass length width height x y z direction color:=black">
    <link name="${name}">
      <visual>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 ${direction}"/>
        <geometry>
          <box size="${length} ${width} ${height}" />
        </geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 ${direction}"/>
        <geometry>
          <box size="${length} ${width} ${height}" />
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${x} ${y} ${z}" rpy="0 0 ${direction}"/>
        <mass value="${mass}"/>
        <inertia
            ixx="${0.25 * mass * width * height}" ixy="0.0" ixz="0.0"
            iyy="${0.25 * mass * width * height}" iyz="0.0"
            izz="${0.5 * mass * width * height}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:frame_model name="main_frame1" mass="${frame_mass}" length="0.15" width="0.15" height="$(arg opening_height)" x="0" y="${0.5 * $(arg env_width)}" z="${0.5 * $(arg opening_height)}" direction="0.0" />
  <xacro:frame_model name="main_frame2" mass="${frame_mass}" length="0.15" width="0.15" height="$(arg opening_height)" x="0" y="${-0.5 * $(arg env_width)}"  z="${0.5 * $(arg opening_height)}" direction="0.0" />
  <xacro:frame_model name="main_frame3" mass="${frame_mass}" length="0.15" width="$(arg env_width)" height="0.15" x="0" y="0"  z="1.925"  direction="0.0"  />


  <joint name="frame_joint1" type="fixed">
    <parent link="main_frame1"/>
    <child link="main_frame2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="frame_joint2" type="fixed">
    <parent link="main_frame1"/>
    <child link="main_frame3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- TODO: change friction rate to paramter -->
  <!-- Noet: 0.13 corresponds to 3.5N -->
  <gazebo reference="main_frame1">
    <material>Gazebo/Black</material>
    <mu1>0.13</mu1>
    <mu2>0.13</mu2>
  </gazebo>

  <gazebo reference="main_frame2">
    <material>Gazebo/Black</material>
    <mu1>0.13</mu1>
    <mu2>0.13</mu2>
  </gazebo>

  <gazebo reference="main_frame3">
    <material>Gazebo/Black</material>
    <mu1>0.13</mu1>
    <mu2>0.13</mu2>
  </gazebo>



  <gazebo>
    <static>true</static>
  </gazebo>


</robot>
